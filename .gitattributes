# Auto detect text files and perform LF normalization
* text=auto

# Python and configs (enforce LF)
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
.gitignore text eol=lf

# Windows scripts (enforce CRLF)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.mp4 binary
